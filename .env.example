# PlasticWatch environment — copy to .env and edit:  cp .env.example .env
# .env is gitignored. Never commit real keys.

# --- Postgres + PostGIS container -------------------------------------------
POSTGRES_USER=plasticwatch
POSTGRES_PASSWORD=plasticwatch
POSTGRES_DB=plasticwatch
POSTGRES_PORT=5432
API_PORT=8000

# Used when running the API OUTSIDE docker (host -> published port).
# docker-compose.yml overrides this to host "db" for the api container.
DATABASE_URL=postgresql+psycopg://plasticwatch:plasticwatch@localhost:5432/plasticwatch
# Seconds before a DB connect gives up. Keeps an unreachable DB from hanging
# API startup and /health (they report postgis=false instead).
DB_CONNECT_TIMEOUT_S=5

# --- Detector (SPEC §6) ------------------------------------------------------
# stub = frozen fake output, real = load backend/weights/best.pt.
# Keep "stub" until ML-3 delivers weights; the whole demo must work on the stub.
DETECTOR_MODE=stub
DETECTOR_WEIGHTS=weights/best.pt
DETECTOR_IMGSZ=640
# Operating threshold from the F1-vs-confidence curve on validation (~0.25-0.4).
DETECTOR_CONF_THRESHOLD=0.3

# --- Confidence tiers (raw confidence is NOT a calibrated probability) ------
# [0, MEDIUM) Low, [MEDIUM, HIGH) Medium, [HIGH, 1] High. Tunable proposals.
CONF_TIER_MEDIUM=0.5
CONF_TIER_HIGH=0.75

# --- Image quality gates -----------------------------------------------------
# Laplacian variance (after resizing to QUALITY_MAX_SIDE) below this = blurry.
# Lenient on purpose; CALIBRATE on the team's local photo set before the demo.
BLUR_MIN_VARIANCE=25
BRIGHTNESS_MIN=35
BRIGHTNESS_MAX=230
QUALITY_MAX_SIDE=1024

# --- Demo area ---------------------------------------------------------------
# OPEN ITEM (SPEC §20.1): the team has not picked a city yet. This blocks the
# Overpass pull, ward boundaries and the seed script. Set both before Stage 2.
# Format: min_lon,min_lat,max_lon,max_lat (EPSG:4326)
DEMO_AREA_BBOX=0,0,0,0
DEMO_AREA_NAME=UNSET

# --- Routing (OpenRouteService) ----------------------------------------------
# OPEN ITEM (SPEC §20.4): confirm the CURRENT free-tier quota for /optimization —
# an older source said ~500/day. Cache the demo route regardless.
ORS_API_KEY=
ORS_DAILY_QUOTA=500

# --- Duplicate detection (SPEC §12) ------------------------------------------
# Merge radius; widened up to DEDUPE_RADIUS_MAX_M when GPS accuracy is poor.
DEDUPE_RADIUS_M=30
DEDUPE_RADIUS_MAX_M=75
GPS_ACCURACY_WIDEN_M=30
# Max pHash Hamming distance for "same image".
PHASH_HAMMING_MAX=6
# A Resolved hotspot within this many days still counts as a merge candidate.
REOPEN_WINDOW_DAYS=90

# --- Scoring (SPEC §11) ------------------------------------------------------
# TUNABLE PROPOSALS, not published truth. Defaults = SPEC §11; changing them
# breaks the golden test (Impact 73.1 / Evidence 0.755) by design.
SCORE_W_SEVERITY=0.35
SCORE_W_RECURRENCE=0.25
SCORE_W_SENSITIVITY=0.30
SCORE_W_PERSISTENCE=0.10
SCORE_SEV_W_COUNT=0.6
SCORE_SEV_W_AREA=0.4
SCORE_SEV_COUNT_SAT=15
SCORE_SEV_AREA_SAT=0.25
SCORE_SEV_LATEST_N=3
SCORE_REC_WINDOW_DAYS=60
SCORE_REC_RETURN_WEIGHT=2
SCORE_REC_DIVISOR=8
SCORE_SENS_W_WATER=0.75
SCORE_SENS_W_AMENITY=0.25
SCORE_PROX_NEAR_M=50
SCORE_PROX_FAR_M=300
SCORE_PERSIST_SAT_DAYS=14
SCORE_EV_W_CONFIDENCE=0.5
SCORE_EV_W_REPORTERS=0.3
SCORE_EV_W_RELIABILITY=0.2
SCORE_EV_REPORTERS_SAT=3
# Half-open bands.
BAND_IMPACT_CRITICAL=70
BAND_IMPACT_HIGH=50
BAND_IMPACT_MEDIUM=30
BAND_EVIDENCE_MODERATE=0.4
BAND_EVIDENCE_STRONG=0.75
# ai_detected -> needs_verification (queues it for a human; never verifies).
PROMOTE_MIN_REPORTERS=2
PROMOTE_MIN_EVIDENCE=0.6

# --- Local disk storage ------------------------------------------------------
UPLOAD_DIR=uploads

# --- Demo auth ---------------------------------------------------------------
# Signs the demo role token. NOT real authentication (CLAUDE.md §8) — the demo
# uses seeded users + a role switcher. It only makes role violations return 403.
DEMO_TOKEN_SECRET=plasticwatch-demo-secret-change-me
DEMO_TOKEN_TTL_HOURS=24
